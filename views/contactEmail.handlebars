                                                cellpadding="0" cellspacing="0" width="100%" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td style="overflow-wrap:break-word;word-break:break-word;padding:0 10px 8px;"
                                                            align="left">
                                                            <div
                                                                style="font-size: 14px; line-height: 160%; text-align: left;">
                                                                <p
                                                                    style="font-size: 14px; line-height: 160%; color:#555;">
                                                                    <strong>Subject:</strong>
                                                                    <span> {{title}}</span>
                                                                </p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="overflow-wrap:break-word;word-break:break-word;padding:0 10px 20px;"
                                                            align="left">
                                                            <div
                                                                style="font-size: 14px; line-height: 160%; text-align: left;">
                                                                <p
                                                                    style="font-size: 14px; line-height: 160%; color:#555;">
                                                                    <strong>Your Message:</strong>
                                                                </p>
                                                                <p
                                                                    style="font-size: 14px; line-height: 160%; margin-top:6px;color:#333;">
                                                                    {{decription}}
                                                                </p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table> --}}

                                            <!-- Optional CTA button: Visit Website -->
                                            <table style="font-family:'Cabin',sans-serif;" role="presentation"
                                                cellpadding="0" cellspacing="0" width="100%" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td style="overflow-wrap:break-word;word-break:break-word;padding:10px 10px 30px;"
                                                            align="center">
                                                            <a href="https://cyberous.in"
                                                                style="display:inline-block;text-decoration:none;-webkit-text-size-adjust:none;text-align:center;color:#FFFFFF;background-color:#5922ED;border-radius:4px;width:auto;max-width:100%;word-wrap:break-word;font-size:14px;">
                                                                <span
                                                                    style="display:block;padding:12px 30px;line-height:120%;">
                                                                    <span
                                                                        style="font-size: 15px; line-height: 18px;"><strong>Visit
                                                                            Our Website</strong></span>
                                                                </span>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CONTACT INFO FOOTER -->
                    <div class="u-row-container" style="padding: 0px;background-color: transparent">
                        <div class="u-row"
                            style="margin: 0 auto;min-width: 320px;max-width: 600px;overflow-wrap: break-word;word-wrap: break-word;word-break: break-word;background-color: #e5eaf5;">
                            <div
                                style="border-collapse: collapse;display: table;width: 100%;height: 100%;background-color: transparent;">
                                <div class="u-col u-col-100"
                                    style="max-width: 320px;min-width: 600px;display: table-cell;vertical-align: top;">
                                    <div style="height: 100%;width: 100% !important;">
