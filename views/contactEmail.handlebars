                                                cellpadding="0" cellspacing="0" width="100%" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td style="overflow-wrap:break-word;word-break:break-word;padding:10px;"
                                                            align="center">
                                                            <div
                                                                style="font-size: 14px; color: #e5eaf5; line-height: 140%; text-align: center;">
                                                                <p
                                                                    style="font-size: 14px; line-height: 140%; letter-spacing: 3px; text-transform: uppercase;">
                                                                    <strong>THANK YOU FOR CONTACTING US</strong>
                                                                </p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                            <table style="font-family:'Cabin',sans-serif;" role="presentation"
                                                cellpadding="0" cellspacing="0" width="100%" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td style="overflow-wrap:break-word;word-break:break-word;padding:0px 10px 0px;"
                                                            align="center">
                                                            <div
