                                                                <p
                                                                    style="font-size: 14px; line-height: 160%;"><span
                                                                        style="font-size: 16px; line-height: 25.6px;">support@cyberous.in</span>
                                                                </p>
                                                                <p
                                                                    style="font-size: 14px; line-height: 160%; margin-top:4px;">
                                                                    <span
                                                                        style="font-size: 14px; line-height: 22.4px;">+91
                                                                        8199985888</span>
                                                                </p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>
                            </div>
