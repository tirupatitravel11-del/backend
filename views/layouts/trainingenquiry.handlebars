<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Training Enquiry - Cyberous</title>
    
    <!-- Outlook Conditional CSS -->
    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->

    <style type="text/css">
        /* --- CLIENT SPECIFIC RESETS --- */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; }
        
        /* --- GENERAL RESETS --- */
        img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        table { border-collapse: collapse !important; }
        body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; font-family: Arial, Helvetica, sans-serif; background-color: #f4f4f4; }
        
        /* --- STYLES --- */
        .wrapper { width: 100%; table-layout: fixed; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        .webkit { max-width: 600px; margin: 0 auto; }
        
        a { color: #0B0D2C; text-decoration: underline; }
        a:hover { text-decoration: none; }
        
        /* --- BUTTON HOVER --- */
        .button-td:hover { background-color: #1a1d4d !important; transition: all 0.3s ease; }
        
        /* --- MOBILE STYLES --- */
        @media screen and (max-width: 600px) {
            .mw-100 { width: 100% !important; max-width: 100% !important; }
            .mobile-padding { padding-left: 20px !important; padding-right: 20px !important; }
            .mobile-stack { display: block !important; width: 100% !important; padding-bottom: 10px !important; text-align: center !important; }
            .mobile-center { text-align: center !important; }
            .logo-img { width: 160px !important; height: auto !important; }
            .h1-mobile { font-size: 24px !important; line-height: 32px !important; }
            .info-table td { display: block; width: 100%; padding-bottom: 5px; }
            .info-label { padding-top: 10px; font-weight: bold; color: #555555; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4;">

    <!-- MAIN WRAPPER -->
    <center class="wrapper" style="width: 100%; table-layout: fixed; background-color: #f4f4f4; padding-bottom: 40px;">
        <div class="webkit">
            
            <!-- PREHEADER TEXT (Hidden) -->
            <div style="display: none; font-size: 1px; color: #fefefe; line-height: 1px; font-family: Arial, Helvetica, sans-serif; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden;">
                New training enquiry received from a prospective student.
            </div>

            <!-- CONTAINER TABLE -->
            <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px;" class="mw-100">
                
                <!-- HEADER SECTION -->
                <tr>
                    <td align="left" bgcolor="#0B0D2C" style="padding: 40px 20px 40px 20px;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                                <td align="center">
                                    <!-- LOGO AREA -->
                                    <!-- IMPORTANT: Upload 'WhatsApp Image 2026-01-19 at 3.57.29 PM.jpeg' to your server and replace the src below -->
                                    <img src="https://placehold.co/180x50/0B0D2C/ffffff?text=CYBEROUS&font=Lato" alt="Cyberous Logo" width="180" style="display: block; border: 0; font-family: Arial, sans-serif; color: #ffffff; font-size: 24px; font-weight: bold;" class="logo-img" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- BODY SECTION -->
                <tr>
                    <td bgcolor="#ffffff" class="mobile-padding" style="padding: 40px 40px 30px 40px; border-bottom: 1px solid #eeeeee;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            
                            <!-- TITLE -->
                            <tr>
                                <td align="left" style="font-family: Arial, Helvetica, sans-serif; font-size: 28px; font-weight: bold; color: #0B0D2C; padding-bottom: 20px;" class="h1-mobile">
                                    Training Enquiry
                                </td>
                            </tr>
                            
                            <!-- GREETING & INTRO -->
                            <tr>
                                <td align="left" style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: #333333; padding-bottom: 25px;">
                                    Hello Cyberous Team,
                                    <br><br>
                                    I am interested in joining your cybersecurity training programs. I would like to learn more about the courses you offer and how they can help advance my career in the field.
                                    <br><br>
                                    Please find my details and query below:
                                </td>
                            </tr>

                            <!-- ENQUIRY DETAILS BOX -->
                            <tr>
                                <td style="padding-bottom: 30px;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f8f9fa" style="border: 1px solid #e0e0e0; border-radius: 4px;">
                                        <tr>
                                            <td style="padding: 20px;">
                                                <table border="0" cellpadding="0" cellspacing="0" width="100%" class="info-table">
                                                    
                                                    <!-- Item 1: Name -->
                                                    <tr>
                                                        <td width="35%" valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            First Name
                                                        </td>
                                                        <td width="65%" valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            {firstName}
                                                        </td>
                                                    </tr>
                                                    
                                                    <!-- Item 2: Last Name -->
                                                    <tr>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;" class="info-label">
                                                            Last Name
                                                        </td>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            {lastName}
                                                        </td>
                                                    </tr>

                                                    <!-- Item 3: Email -->
                                                    <tr>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;" class="info-label">
                                                            Email
                                                        </td>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            {email}
                                                        </td>
                                                    </tr>

                                                    <!-- Item 4: Phone -->
                                                    <tr>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;" class="info-label">
                                                            Phone
                                                        </td>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            {phone}
                                                        </td>
                                                    </tr>

                                                    <!-- Item 5: Subject -->
                                                    <tr>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;" class="info-label">
                                                            Subject
                                                        </td>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid #eeeeee;">
                                                            {subject}
                                                        </td>
                                                    </tr>

                                                    <!-- Item 6: Message -->
                                                    <tr>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; color: #555555; padding-top: 10px;" class="info-label">
                                                            Your Message
                                                        </td>
                                                        <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; padding-top: 10px;">
                                                            {message}
                                                        </td>
                                                    </tr>

                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <!-- CLOSING -->
                            <tr>
                                <td align="left" style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: #333333; padding-bottom: 30px;">
                                    Please let me know the details of your upcoming batches and enrollment process.
                                </td>
                            </tr>

                            <!-- CTA BUTTON -->
                            <tr>
                                <td align="center" style="padding-bottom: 10px;">
                                    <table border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="center" bgcolor="#0B0D2C" style="border-radius: 4px;" class="button-td">
                                                <a href="mailto:contact@cyberous.in" target="_blank" style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; text-decoration: none; display: inline-block; padding: 14px 30px; border: 1px solid #0B0D2C; border-radius: 4px;">
                                                    Reply to Enquiry
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                        </table>
                    </td>
                </tr>

                <!-- FOOTER SECTION -->
                <tr>
                    <td bgcolor="#0B0D2C" class="mobile-padding" style="padding: 30px 40px;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            
                            <!-- FOOTER COLUMNS -->
                            <tr>
                                <td valign="top" style="padding-bottom: 20px; border-bottom: 1px solid #2e3052;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                        <tr>
                                            <!-- COMPANY INFO (Left on Desktop, Top on Mobile) -->
                                            <td valign="middle" width="50%" class="mobile-stack" style="font-family: Arial, Helvetica, sans-serif; color: #ffffff; font-size: 14px; line-height: 20px;">
                                                <strong style="font-size: 16px;">Cyberous</strong><br>
                                                <span style="font-size: 8px; style="color: #b0b1bd;">Securing Your Digital Space</span><br>
                                                <a href="https://www.cyberous.in" style="color: #ffffff; text-decoration: none;">www.cyberous.in</a>
                                            </td>

                                            <!-- SOCIAL ICONS (Right on Desktop, Bottom on Mobile) -->
                                            <td valign="middle" width="50%" align="right" class="mobile-stack">
                                                <table border="0" cellpadding="0" cellspacing="0" align="right" class="mobile-center" style="margin: 0 auto 0 auto;">
                                                    <tr>
                                                        <td style="padding: 0 5px;">
                                                            <a href="https://linkedin.com" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/linkedin.png" alt="LinkedIn" width="24" height="24" style="display: block; border: 0;" /></a>
                                                        </td>
                                                        <td style="padding: 0 5px;">
                                                            <a href="https://twitter.com" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/twitterx--v1.png" alt="Twitter" width="24" height="24" style="display: block; border: 0;" /></a>
                                                        </td>
                                                        <td style="padding: 0 5px;">
                                                            <a href="https://facebook.com" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/facebook-new.png" alt="Facebook" width="24" height="24" style="display: block; border: 0;" /></a>
                                                        </td>
                                                        <td style="padding: 0 5px;">
                                                            <a href="https://instagram.com" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/instagram-new.png" alt="Instagram" width="24" height="24" style="display: block; border: 0;" /></a>
                                                        </td>
                                                        <td style="padding: 0 5px;">
                                                            <a href="https://youtube.com" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/youtube-play.png" alt="YouTube" width="24" height="24" style="display: block; border: 0;" /></a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <!-- COPYRIGHT & DISCLAIMER -->
                            <tr>
                                <td align="center" style="padding-top: 20px; font-family: Arial, Helvetica, sans-serif; font-size: 11px; line-height: 16px; color: #7a7c91;">
                                    &copy; 2026 Cyberous. All rights reserved.<br>
                                    Global Operations &bull; San Francisco &bull; London &bull; Singapore
                                    <br><br>
                                    This email and any files transmitted with it are confidential and intended solely for the use of the individual or entity to whom they are addressed. If you have received this email in error, please notify the system manager.
                                </td>
                            </tr>
                            
                        </table>
                    </td>
                </tr>
                
            </table>
            <!-- END CONTAINER -->
            
        </div>
    </center>
</body>
</html>